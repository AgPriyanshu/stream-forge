# Copy to config.yaml and replace the admin key (deployment.admin.admin_key) before running.
---
etcd:
  timeout: 30
  watch_timeout: 50
  startup_retry: 2
  prefix: /apisix
  tls:
    verify: true
  host:
    - http://etcd:2379
plugin_attr:
  prometheus:
    export_uri: /apisix/prometheus/metrics
    metric_prefix: apisix_
    refresh_interval: 15
    enable_export_server: true
    export_addr:
      ip: 127.0.0.1
      port: 9091
  log-rotate:
    timeout: 10000
    interval: 3600
    max_size: -1
    max_kept: 168
    enable_compression: false
  ai-proxy:
    http_client: ngx_http_ffi_client
  skywalking:
    service_instance_name: APISIX Instance Name
    report_interval: 3
    service_name: APISIX
    endpoint_addr: http://127.0.0.1:12800
  zipkin:
    set_ngx_var: false
  proxy-mirror:
    timeout:
      send: 60s
      connect: 60s
      read: 60s
  server-info:
    report_ttl: 60
  opentelemetry:
    resource:
      service.name: APISIX
    collector:
      address: 127.0.0.1:4318
      request_headers:
        Authorization: token
      request_timeout: 3
    batch_span_processor:
      drop_on_queue_full: false
      max_queue_size: 1024
      batch_timeout: 2
      inactive_timeout: 1
      max_export_batch_size: 16
    trace_id_source: x-request-id
    set_ngx_var: false
  dubbo-proxy:
    upstream_multiplex_count: 32
  inspect:
    delay: 3
    hooks_file: /usr/local/apisix/plugin_inspect_hooks.lua
stream_plugins:
  - ip-restriction
  - limit-conn
  - mqtt-proxy
  - syslog
  - traffic-split
graphql:
  max_size: 1048576
deployment:
  config_provider: etcd
  etcd:
    timeout: 30
    watch_timeout: 50
    startup_retry: 2
    prefix: /apisix
    tls:
      verify: true
    host:
      - http://etcd:2379
  role: traditional
  role_traditional:
    config_provider: etcd
  admin:
    admin_listen:
      ip: 0.0.0.0
      port: 9180
    admin_key_required: true
    enable_admin_ui: true
    enable_admin_cors: true
    allow_admin:
      - 0.0.0.0/0
    admin_api_version: v3
    admin_key:
      - name: admin
        role: admin
        key: CHANGE_ME_ADMIN_KEY
apisix:
  enable_server_tokens: true
  router:
    http: radixtree_host_uri
    ssl: radixtree_sni
  max_post_args_readable_size: 64
  resolver_timeout: 5
  ssl:
    ssl_session_tickets: false
    ssl_trusted_certificate: /etc/ssl/certs/ca-certificates.crt
    enable: true
    ssl_protocols: TLSv1.2 TLSv1.3
    listen:
      - port: 9443
        enable_http3: false
    ssl_ciphers: ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384
  disable_upstream_healthcheck: false
  tracing: false
  normalize_uri_like_servlet: false
  lru:
    secret:
      neg_count: 512
      ttl: 300
      count: 512
      neg_ttl: 60
  data_encryption:
    enable_encrypt_fields: true
    keyring:
      - qeddd145sfvddff3
      - edd1c9f0985e76a2
  proxy_cache:
    cache_ttl: 10s
    zones:
      - memory_size: 50m
        disk_size: 1G
        disk_path: /tmp/disk_cache_one
        name: disk_cache_one
        cache_levels: "1:2"
      - name: memory_cache
        memory_size: 50m
  proxy_mode: http
  enable_control: true
  disable_sync_configuration_during_start: false
  worker_startup_time_threshold: 60
  node_listen:
    - 9080
  enable_dev_mode: false
  enable_reuseport: true
  match_uri_encoded_slash: false
  enable_admin: true
  extra_lua_cpath: ""
  enable_ipv6: true
  enable_http2: true
  extra_lua_path: ""
  show_upstream_status_in_response_header: false
  delete_uri_tail_slash: false
  enable_resolv_search_opt: true
plugins:
  - real-ip
  - ai
  - client-control
  - proxy-buffering
  - proxy-control
  - request-id
  - zipkin
  - ext-plugin-pre-req
  - fault-injection
  - mocking
  - serverless-pre-function
  - cors
  - ip-restriction
  - ua-restriction
  - referer-restriction
  - csrf
  - uri-blocker
  - request-validation
  - chaitin-waf
  - multi-auth
  - openid-connect
  - saml-auth
  - cas-auth
  - authz-casbin
  - authz-casdoor
  - wolf-rbac
  - ldap-auth-advanced
  - ldap-auth
  - hmac-auth
  - basic-auth
  - jwt-auth
  - jwe-decrypt
  - key-auth
  - dingtalk-auth
  - feishu-auth
  - acl
  - consumer-restriction
  - attach-consumer-label
  - forward-auth
  - opa
  - authz-keycloak
  - data-mask
  - proxy-cache
  - body-transformer
  - ai-prompt-template
  - ai-prompt-decorator
  - ai-prompt-guard
  - ai-rag
  - ai-rate-limiting
  - ai-proxy-multi
  - ai-proxy
  - ai-cache
  - ai-aws-content-moderation
  - ai-aliyun-content-moderation
  - ai-lakera-guard
  - proxy-mirror
  - graphql-proxy-cache
  - proxy-rewrite
  - workflow
  - api-breaker
  - graphql-limit-count
  - limit-conn
  - limit-count
  - limit-req
  - gzip
  - traffic-label
  - traffic-split
  - redirect
  - response-rewrite
  - openapi-to-mcp
  - oas-validator
  - mcp-bridge
  - degraphql
  - kafka-proxy
  - websocket-proxy
  - grpc-transcode
  - grpc-web
  - http-dubbo
  - public-api
  - prometheus
  - datadog
  - lago
  - loki-logger
  - elasticsearch-logger
  - echo
  - loggly
  - http-logger
  - splunk-hec-logging
  - skywalking-logger
  - google-cloud-logging
  - sls-logger
  - tcp-logger
  - kafka-logger
  - rocketmq-logger
  - syslog
  - udp-logger
  - file-logger
  - clickhouse-logger
  - tencent-cloud-cls
  - inspect
  - example-plugin
  - aws-lambda
  - azure-functions
  - openwhisk
  - openfunction
  - serverless-post-function
  - ext-plugin-post-req
  - ext-plugin-post-resp
  - ai-request-rewrite
nginx_config:
  enable_cpu_affinity: false
  worker_rlimit_nofile: 20480
  worker_shutdown_timeout: 240s
  max_pending_timers: 16384
  max_running_timers: 4096
  meta:
    lua_shared_dict:
      prometheus-cache: 10m
      standalone-config: 10m
      standalone-status: 1m
      upstream-healthcheck: 10m
      status-report: 1m
      prometheus-metrics: 128m
  event:
    worker_connections: 10620
  stream:
    lua_shared_dict:
      worker-events-stream: 10m
      tars-stream: 1m
      etcd-cluster-health-check-stream: 10m
      lrucache-lock-stream: 10m
      plugin-limit-conn-stream: 10m
    access_log_format:
      $remote_addr [$time_local] $protocol $status $bytes_sent $bytes_received
      $session_time
    access_log_format_escape: default
    metrics_zone_size: 1m
    enable_access_log: false
    access_log: logs/access_stream.log
  http:
    client_header_timeout: 60s
    upstream:
      keepalive_timeout: 60s
      keepalive: 320
      keepalive_requests: 1000
    client_max_body_size: 0
    send_timeout: 10s
    underscores_in_headers: "on"
    real_ip_header: X-Real-IP
    real_ip_recursive: "off"
    real_ip_from:
      - 127.0.0.1
      - "unix:"
    lua_shared_dict:
      plugin-saml-auth-replay: 10m
      plugin-graphql-limit-count: 10m
      plugin-graphql-limit-count-reset-header: 10m
      prometheus-metrics: 128m
      plugin-api-breaker: 10m
      discovery: 1m
      jwks: 1m
      introspection: 10m
      ocsp-stapling: 10m
      access-tokens: 1m
      ext-plugin: 1m
      mcp-session: 10m
      cas-auth: 10m
      internal-status: 10m
      worker-events: 10m
      lrucache-lock: 10m
      upstream-slow-start: 10m
      balancer-ewma: 10m
      balancer-ewma-locks: 10m
      balancer-ewma-last-touched-at: 10m
      etcd-cluster-health-check: 10m
      plugin-ai-rate-limiting: 10m
      plugin-ai-rate-limiting-reset-header: 10m
      plugin-limit-conn: 10m
      plugin-limit-conn-redis-cluster-slot-lock: 1m
      plugin-limit-req-redis-cluster-slot-lock: 1m
      plugin-limit-req: 10m
      plugin-limit-count: 10m
      plugin-limit-count-lock: 1m
      plugin-limit-count-redis-cluster-slot-lock: 1m
      tars: 1m
      tracing_buffer: 32m
    proxy_ssl_server_name: true
    charset: utf-8
    variables_hash_max_size: 2048
    enable_access_log: true
    access_log: logs/access.log
    access_log_format:
      $remote_addr - $remote_user [$time_local] $http_host "$request"
      $status $body_bytes_sent $request_time "$http_referer" "$http_user_agent" $upstream_addr
      $upstream_status $upstream_response_time "$upstream_scheme://$upstream_host$upstream_uri"
      "$apisix_request_id"
    access_log_format_escape: default
    access_log_buffer: 16384
    keepalive_timeout: 60s
    client_body_timeout: 60s
  stream_configuration_snippet: ""
  error_log: logs/error.log
  http_admin_configuration_snippet: ""
  http_end_configuration_snippet: ""
  main_configuration_snippet: ""
  http_configuration_snippet: ""
  http_server_configuration_snippet: ""
  http_server_location_configuration_snippet: ""
  error_log_level: warn
  worker_processes: auto
...
